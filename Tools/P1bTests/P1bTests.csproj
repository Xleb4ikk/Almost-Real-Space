<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <Import Project="$(MSBuildThisFileDirectory)..\GameSources.props" />
  <ItemGroup>
    <Compile Include="UnityStubs.cs" />
    <Compile Include="Program.cs" />
    <Compile Include="TestSupport.cs" />
    <Compile Include="CheckSupport.cs" />
    <Compile Include="TestRegistry.cs" />
    <Compile Include="Tests\**\*.cs" />
    <Compile Include="Study\**\*.cs" Exclude="Study\TaylorVsY6\**\*.cs" />
    <Compile Include="Reference\**\*.cs" />
    <Compile Include="LandingTrace.cs" />
  </ItemGroup>
  <ItemGroup>
    <None Include="Data\test_vessel_t1.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="Data\site_1_colliders.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
