<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblyName>TaylorVsY6</AssemblyName>
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
  </PropertyGroup>
  <Import Project="$(MSBuildThisFileDirectory)..\..\..\GameSources.props" />
  <ItemGroup>
    <Compile Include="Compare.cs" />
    <Compile Include="CountingSource.cs" />
    <Compile Include="..\..\UnityStubs.cs" />
    <Compile Include="..\..\CheckSupport.cs" />
    <Compile Include="..\core\**\*.cs" />
    <Compile Include="..\fixtures\**\*.cs" />
    <Compile Include="..\methods\**\*.cs" />
    <Compile Include="..\references\**\*.cs" />
    <Compile Include="..\scenarios\**\*.cs" Exclude="..\scenarios\KnownProblems.cs" />
    <Compile Include="..\..\Reference\**\*.cs" />
  </ItemGroup>
</Project>
