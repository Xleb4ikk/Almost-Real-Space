digraph OrbitIntegratorTest {
    graph [rankdir=TD, splines=ortho, nodesep=0.35, ranksep=0.42, fontname="Arial", bgcolor="#ffffff", pad=0.25];
    node  [shape=box, style="rounded,filled", fontname="Arial", fontsize=11, margin="0.14,0.08", color="#5b6b7a", penwidth=1.1];
    edge  [fontname="Arial", fontsize=10, color="#5b6b7a", arrowsize=0.75];

    start [label="Test551: самопроверка стенда\nпорядок · стоимость вызовов · бюджеты", fillcolor="#e8f0fe"];
    scenario [label="Сценарий\nорбита · модель силы · горизонт · контрольные точки", fillcolor="#e8f0fe"];

    ref [label="Построение эталона\nfixed DOP853 (h, h/2, h/4) · dd-Taylor · Kepler", fillcolor="#fff4e5"];
    cert [label="Эталон сертифицирован?\nсходимость и floor конечны", shape=diamond, style="filled", fillcolor="#fff4e5", margin="0.03,0.02"];
    detail [label="Только detail / regression\nв рейтинг не входит", fillcolor="#f5f5f5", fontcolor="#777777"];
    floor [label="Floor = собственная неопределённость эталона\nцели ниже 10 × floor → skip", fillcolor="#fff4e5"];

    sweep [label="Свип\nfixed: h × 1.5   |   adaptive: rtol × √10\n+ cap-варианты (600 с / 86400 с)", fillcolor="#e6f4ea"];
    run [label="Прогон траектории\nошибка в контрольных точках\nстоимость = RHS-эквиваленты", fillcolor="#e6f4ea"];

    cells [label="Work-precision: 100 м / 10 м / 1 м\nlog-log интерполяция только при валидном брекете", fillcolor="#e6f4ea"];
    status [label="Статус ячейки", shape=diamond, style="filled", fillcolor="#e6f4ea", margin="0.03,0.02"];

    ok [label="OK\nцена достижима", fillcolor="#d9ead3"];
    edgenode [label="EDGE\nверхняя оценка;\nбез cap → unresolved", fillcolor="#fce5cd"];
    bad [label="FLOOR / NR / NA\nисключить", fillcolor="#f4cccc"];

    rank [label="Победитель по сценарию и цели\n+ диагностика: ничьи · cap-bound · round-off · немонотонность", fillcolor="#d9d2e9"];
    verdict [label="Итоговый выбор", fillcolor="#d9d2e9"];

    prod [label="Production (drag / тяга / масса)\nDOP853-adaptive", fillcolor="#cfe2f3"];
    pure [label="Чистая гравитация, универсально\nRKN12(10)", fillcolor="#cfe2f3"];
    near [label="Чистая гравитация, околоземные\nWH-BM14A / WH-Y6", fillcolor="#cfe2f3"];

    start -> scenario -> ref -> cert;
    cert -> detail [label=" нет"];
    cert -> floor [label=" да"];
    floor -> sweep -> run -> cells -> status;
    status -> ok [label=" OK"];
    status -> edgenode [label=" EDGE"];
    status -> bad [label=" прочее"];
    ok -> rank;
    edgenode -> rank;
    bad -> rank [style=dashed, label="как ограничение"];
    rank -> verdict;
    verdict -> prod;
    verdict -> pure;
    verdict -> near;

    { rank=same; prod; pure; near; }
}
