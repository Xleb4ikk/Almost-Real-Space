<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.6.1" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <!--
    Core is compiled from the real sources, by glob. There is deliberately no
    ProjectReference to a generated Unity csproj, no UnityStubs and no
    UNITY_5_3_OR_NEWER: if Core ever pulls UnityEngine back in, this project
    must stop compiling.
  -->
  <ItemGroup>
    <Compile Include="**\*.cs" Exclude="bin\**\*.cs;obj\**\*.cs" />
    <Compile Include="..\..\Assets\_Project\Scripts\Core\**\*.cs"
             Link="Core\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- Oracle references: linked, not copied. They use only System.* and are
       not part of the P1bTests harness infrastructure. -->
  <ItemGroup>
    <Compile Include="..\..\Tools\P1bTests\Reference\TaylorJet.cs"
             Link="Oracle\TaylorJet.cs" />
    <Compile Include="..\..\Tools\P1bTests\Reference\TaylorNBody.cs"
             Link="Oracle\TaylorNBody.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Update="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Existing golden files are linked from the stand so there is exactly one
       copy on disk. Core-specific golden files live under GoldenData and are
       generated by GoldenData\gen_core_kepler.py, never by a test. -->
  <ItemGroup>
    <None Include="..\..\Tools\P1bTests\Study\taylor\golden\golden_real.json"
          Link="GoldenData\golden_real.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\Tools\P1bTests\Study\taylor\golden\golden_real_1y_hi.json"
          Link="GoldenData\golden_real_1y_hi.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\Tools\P1bTests\Study\taylor\golden\golden_real_10y_k28.json"
          Link="GoldenData\golden_real_10y_k28.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="GoldenData\golden_core_kepler.json"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="GoldenData\golden_core_kepler_10y.json"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
