+namespace Galilego.Simulation.Player
+{
+    /// <summary>
+    /// ╨Ю╨┐╨╛╤А╨░ тАФ ╨░╨╜╨░╨╗╨╕╤В╨╕╤З╨╡╤Б╨║╨╕╨╣ ╤А╨╡╨╗╤М╨╡╤Д (ITerrainModel) ╨▓ ╨╗╨╛╨║╨░╨╗╤М╨╜╨╛╨╝ ╨║╨░╨┤╤А╨╡ ╨╝╨╡╤Б╤В╨░:
