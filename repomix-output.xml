            terrain = body?.Terrain as HeightfieldTerrain;
            if (body == null || terrain == null)
            {
                // Р“Р»Р°РґРєР°СЏ СЃС„РµСЂР° РёР»Рё С‚РµР»Рѕ РЅРµ РЅР°Р№РґРµРЅРѕ вЂ” СЃС‚Р°СЂС‹Р№ РІРёР·СѓР°Р» РЅРµ С‚СЂРѕРіР°РµРј.
